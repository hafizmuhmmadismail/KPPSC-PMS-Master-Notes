*.env
.venv/
env/

# Office / Temporary Lock Files
~$*.docx
*.tmp

# Operating System Files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# IDE & Editor Settings
.vscode/
.idea/
*.swp
*.swo
